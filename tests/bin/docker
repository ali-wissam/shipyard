#!/usr/bin/env bash

LOG_FILE="${SHIPYARD_MOCK_DOCKER_LOG:-/tmp/mock-docker.log}"
PID_FILE="${SHIPYARD_TEST_DOCKER_PID_FILE:-/tmp/mock-docker.pid}"
PORT="${SHIPYARD_TEST_DOCKER_PORT:-8080}"
STATE_FILE="${SHIPYARD_MOCK_DOCKER_STATE:-/tmp/mock-docker.state}"

echo "docker $*" >> "$LOG_FILE"

if [[ " $* " == *" down -v "* ]] || [[ " $* " == *" down "*"-v"* ]]; then
  echo "forbidden: docker compose down -v" >> "$LOG_FILE"
  exit 1
fi

mock_start_server() {
  if [ -f "$PID_FILE" ]; then
    kill "$(cat "$PID_FILE")" 2>/dev/null || true
    rm -f "$PID_FILE"
  fi

  if [ "${SHIPYARD_MOCK_DOCKER_SKIP_SERVER:-0}" = "1" ]; then
    return 0
  fi

  local status_code="200"
  if [ "${SHIPYARD_MOCK_DOCKER_UNHEALTHY_HTTP:-0}" = "1" ]; then
    status_code="503"
  fi

  python3 -c "
import http.server
import sys

port = int(sys.argv[1])
status_code = int(sys.argv[2])

class Handler(http.server.BaseHTTPRequestHandler):
    def do_GET(self):
        self.send_response(status_code)
        self.end_headers()
        if status_code < 400:
            self.wfile.write(b'ok')
    def log_message(self, format, *args):
        return

http.server.HTTPServer(('127.0.0.1', port), Handler).serve_forever()
" "$PORT" "$status_code" >/dev/null 2>&1 &

  echo "$!" > "$PID_FILE"
  echo "active_release=$SHIPYARD_MOCK_ACTIVE_RELEASE" > "$STATE_FILE"
}

if [ "${1:-}" != "compose" ]; then
  exit 0
fi

shift

while [ $# -gt 0 ]; do
  case "$1" in
    -p)
      shift 2
      ;;
    -f)
      COMPOSE_FILE="${2:-}"
      if [ -n "${COMPOSE_FILE:-}" ] && [ -f "$COMPOSE_FILE" ]; then
        SHIPYARD_MOCK_ACTIVE_RELEASE="$(basename "$(dirname "$COMPOSE_FILE")")"
        export SHIPYARD_MOCK_ACTIVE_RELEASE
      fi
      shift 2
      ;;
    up)
      if [ "${SHIPYARD_MOCK_DOCKER_FAIL_BUILD:-0}" = "1" ] && [[ " $* " == *" --build "* ]]; then
        echo "mock build failure" >> "$LOG_FILE"
        exit 1
      fi

      if [ "${SHIPYARD_MOCK_DOCKER_FAIL_UP:-0}" = "1" ]; then
        echo "mock compose up failure" >> "$LOG_FILE"
        exit 1
      fi

      if [[ " $* " == *" -d "* ]] || [[ " $* " == *" -d" ]]; then
        mock_start_server
      fi
      exit 0
      ;;
    ps)
      if [[ " $* " == *" running "* ]] || [[ " $* " == *"--status running"* ]]; then
        if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
          echo "mock-container-id"
        elif [ "${SHIPYARD_MOCK_DOCKER_FAIL_UP:-0}" != "1" ] && [ "${SHIPYARD_MOCK_DOCKER_SKIP_SERVER:-0}" != "1" ] && [ "${SHIPYARD_MOCK_DOCKER_UNHEALTHY_HTTP:-0}" != "1" ]; then
          :
        fi
      fi
      exit 0
      ;;
    logs|config)
      exit 0
      ;;
    *)
      shift
      ;;
  esac
done

exit 0
