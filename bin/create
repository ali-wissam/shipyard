#!/usr/bin/env bash
set -euo pipefail

SHIPYARD_ROOT="${SHIPYARD_ROOT:-/opt/shipyard}"
# shellcheck source=/dev/null
source "$SHIPYARD_ROOT/lib/config.sh"

DOMAIN="_"
TYPE="static"
DOCKER_PORT="8080"
CREATE_SUCCEEDED=false

CREATED_PROJECT_DIR=false
CREATED_CONFIG=false
CREATED_NGINX_AVAILABLE=false
CREATED_NGINX_ENABLED=false

rollback_create() {
  if [ "$CREATE_SUCCEEDED" = true ]; then
    return 0
  fi

  if [ "$CREATED_NGINX_ENABLED" = true ] && [ -L "$NGINX_ENABLED" ]; then
    rm -f "$NGINX_ENABLED"
  fi

  if [ "$CREATED_NGINX_AVAILABLE" = true ] && [ -f "$NGINX_AVAILABLE" ]; then
    rm -f "$NGINX_AVAILABLE"
  fi

  if [ "$CREATED_CONFIG" = true ] && [ -f "$CONFIG_FILE" ]; then
    rm -f "$CONFIG_FILE"
  fi

  if [ "$CREATED_PROJECT_DIR" = true ] && [ -d "$PROJECT_DIR" ]; then
    rm -rf "$PROJECT_DIR"
  fi
}

trap rollback_create EXIT

require_root() {
  if [ "${SHIPYARD_SKIP_ROOT_CHECK:-0}" = "1" ]; then
    return 0
  fi

  if [ "$(id -u)" -ne 0 ]; then
    echo "shipyard create must be run with sudo."
    if [ "$TYPE" = "docker" ]; then
      echo "Try: sudo shipyard create $PROJECT --type $TYPE --domain $DOMAIN --port $DOCKER_PORT"
    else
      echo "Try: sudo shipyard create $PROJECT --type $TYPE --domain $DOMAIN"
    fi
    exit 1
  fi
}

write_nginx_config() {
  if [ "$TYPE" = "docker" ]; then
    sed \
      -e "s|{{PROJECT_NAME}}|$PROJECT|g" \
      -e "s|{{PROJECT_DIR}}|$PROJECT_DIR|g" \
      -e "s|{{DOMAIN}}|$DOMAIN|g" \
      -e "s|{{DOCKER_PORT}}|$DOCKER_PORT|g" \
      "$TEMPLATE" > "$NGINX_AVAILABLE"
  else
    sed \
      -e "s|{{PROJECT_NAME}}|$PROJECT|g" \
      -e "s|{{PROJECT_DIR}}|$PROJECT_DIR|g" \
      -e "s|{{DOMAIN}}|$DOMAIN|g" \
      "$TEMPLATE" > "$NGINX_AVAILABLE"
  fi
}

PROJECT="${1:-}"

shift || true

while [ $# -gt 0 ]; do
  case "$1" in
    --domain)
      DOMAIN="${2:-}"
      shift 2
      ;;
    --type)
      TYPE="${2:-}"
      shift 2
      ;;
    --port)
      DOCKER_PORT="${2:-}"
      shift 2
      ;;
    *)
      echo "Unknown option: $1"
      exit 1
      ;;
  esac
done

if [ -z "$PROJECT" ]; then
  echo "Usage: sudo shipyard create <project> [--domain example.com] [--type static|laravel|node|docker] [--port <port>]"
  exit 1
fi

if [[ ! "$PROJECT" =~ ^[a-zA-Z0-9_-]+$ ]]; then
  echo "Invalid project name. Use only letters, numbers, hyphen, and underscore."
  exit 1
fi

case "$TYPE" in
  static|laravel|node|docker)
    ;;
  *)
    echo "Unsupported type: $TYPE"
    echo "Supported types: static, laravel, node, docker"
    exit 1
    ;;
esac

if [ "$TYPE" = "docker" ]; then
  if ! validate_tcp_port "$DOCKER_PORT"; then
    exit 1
  fi
fi

PROJECT_DIR="$SITES_ROOT/$PROJECT"
CONFIG_FILE="$CONFIG_DIR/$PROJECT.conf"
NGINX_AVAILABLE="$NGINX_SITES_AVAILABLE/$PROJECT"
NGINX_ENABLED="$NGINX_SITES_ENABLED/$PROJECT"
TEMPLATE="$SHIPYARD_ROOT/templates/nginx/$TYPE.conf"

require_root

if [ ! -f "$TEMPLATE" ]; then
  echo "Template not found: $TEMPLATE"
  exit 1
fi

if [ -e "$PROJECT_DIR" ]; then
  echo "Project directory already exists: $PROJECT_DIR"
  exit 1
fi

if [ -e "$CONFIG_FILE" ]; then
  echo "Config already exists: $CONFIG_FILE"
  exit 1
fi

if [ -e "$NGINX_AVAILABLE" ]; then
  echo "Nginx config already exists: $NGINX_AVAILABLE"
  exit 1
fi

if [ -e "$NGINX_ENABLED" ]; then
  echo "Nginx site already enabled: $NGINX_ENABLED"
  exit 1
fi

mkdir -p "$PROJECT_DIR/releases"
mkdir -p "$PROJECT_DIR/shared"
CREATED_PROJECT_DIR=true

mkdir -p "$CONFIG_DIR"

if [ "$TYPE" = "docker" ]; then
  cat > "$CONFIG_FILE" <<EOF
PROJECT_NAME="$PROJECT"
PROJECT_DIR="$PROJECT_DIR"
KEEP_RELEASES=5
TYPE="$TYPE"
DOMAIN="$DOMAIN"
DOCKER_PORT="$DOCKER_PORT"
DOCKER_COMPOSE_FILE="docker-compose.prod.yml"
DOCKER_HEALTH_PATH="/"
EOF
else
  cat > "$CONFIG_FILE" <<EOF
PROJECT_NAME="$PROJECT"
PROJECT_DIR="$PROJECT_DIR"
KEEP_RELEASES=5
TYPE="$TYPE"
HEALTH_CHECK_FILE="index.html"
DOMAIN="$DOMAIN"
EOF
fi
CREATED_CONFIG=true

mkdir -p "$NGINX_SITES_AVAILABLE"
mkdir -p "$NGINX_SITES_ENABLED"

write_nginx_config
CREATED_NGINX_AVAILABLE=true

ln -s "$NGINX_AVAILABLE" "$NGINX_ENABLED"
CREATED_NGINX_ENABLED=true

if [ "${SHIPYARD_SKIP_NGINX_RELOAD:-0}" != "1" ]; then
  if ! nginx -t; then
    echo "Nginx configuration test failed."
    exit 1
  fi

  if command -v systemctl >/dev/null 2>&1; then
    systemctl reload nginx
  fi
fi

CREATE_SUCCEEDED=true
trap - EXIT

echo ""
echo "✔ Project created successfully"
echo ""
echo "Project"
echo "  Name   : $PROJECT"
echo "  Type   : $TYPE"
echo "  Domain : $DOMAIN"
if [ "$TYPE" = "docker" ]; then
  echo "  Port   : $DOCKER_PORT"
fi
echo ""
echo "Paths"
echo "  Directory : $PROJECT_DIR"
echo "  Config    : $CONFIG_FILE"
echo "  Nginx     : $NGINX_AVAILABLE"
echo ""
echo "Next steps"
echo "  1. Point your domain DNS to this server"
echo "  2. Add your GitHub Actions deployment workflow"
echo "  3. Deploy with:"
echo "     shipyard deploy $PROJECT /tmp/artifact.tar.gz <release-id>"
