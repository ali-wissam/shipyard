#!/usr/bin/env bash
set -euo pipefail

SHIPYARD_ROOT="${SHIPYARD_ROOT:-/opt/shipyard}"
# shellcheck source=/dev/null
source "$SHIPYARD_ROOT/lib/config.sh"
# shellcheck source=/dev/null
source "$SHIPYARD_ROOT/lib/docker.sh"

PROJECT="${1:-}"
ARTIFACT_PATH="${2:-}"
RELEASE_ID="${3:-}"

if [ -z "$PROJECT" ] || [ -z "$ARTIFACT_PATH" ] || [ -z "$RELEASE_ID" ]; then
  echo "Usage: shipyard deploy <project> <artifact-path> <release-id>"
  exit 1
fi

load_project_config "$PROJECT"

RELEASES_DIR="$PROJECT_DIR/releases"
CURRENT_LINK="$PROJECT_DIR/current"
RELEASE_DIR="$RELEASES_DIR/$RELEASE_ID"
KEEP="${KEEP_RELEASES:-5}"
TYPE="${TYPE:-static}"
HEALTH_FILE="${HEALTH_CHECK_FILE:-index.html}"
LOG_FILE="$LOG_DIR/$PROJECT.log"

mkdir -p "$LOG_DIR"

if [ ! -f "$ARTIFACT_PATH" ]; then
  echo "Artifact not found: $ARTIFACT_PATH"
  exit 1
fi

mkdir -p "$RELEASES_DIR" "$RELEASE_DIR"

{
  echo "[$(date '+%Y-%m-%d %H:%M:%S')] Deploy started: $PROJECT $RELEASE_ID"
} >> "$LOG_FILE"

PREVIOUS_RELEASE=""
if [ -L "$CURRENT_LINK" ]; then
  PREVIOUS_RELEASE="$(readlink -f "$CURRENT_LINK")"
fi

switch_current_release() {
  local target="$1"

  if [ -L "$CURRENT_LINK" ]; then
    rm "$CURRENT_LINK"
  elif [ -d "$CURRENT_LINK" ]; then
    rm -rf "$CURRENT_LINK"
  fi

  ln -s "$target" "$CURRENT_LINK"
}

docker_deploy_abort() {
  local reason="$1"

  echo "$reason"
  docker_log_failure "$LOG_FILE" "$reason" "$PROJECT" "$RELEASE_DIR" "${DOCKER_COMPOSE_FILE:-docker-compose.prod.yml}"

  if [ -n "$PREVIOUS_RELEASE" ] && [ -d "$PREVIOUS_RELEASE" ]; then
    echo "Restoring previous Docker deployment..."
    if ! docker_restore_release \
      "$PROJECT" \
      "$PROJECT_DIR" \
      "$PREVIOUS_RELEASE" \
      "${DOCKER_COMPOSE_FILE:-docker-compose.prod.yml}" \
      "${DOCKER_PORT:-8080}" \
      "${DOCKER_HEALTH_PATH:-/}" \
      "$LOG_FILE"; then
      echo "Warning: failed to restore previous Docker deployment"
      {
        echo "[$(date '+%Y-%m-%d %H:%M:%S')] Warning: failed to restore previous Docker deployment"
      } >> "$LOG_FILE"
    fi
  fi

  if [ -L "$CURRENT_LINK" ] && [ "$(readlink -f "$CURRENT_LINK")" = "$(readlink -f "$RELEASE_DIR")" ]; then
    rm "$CURRENT_LINK"
    if [ -n "$PREVIOUS_RELEASE" ] && [ -d "$PREVIOUS_RELEASE" ]; then
      ln -s "$PREVIOUS_RELEASE" "$CURRENT_LINK"
    fi
  fi

  if [ -d "$RELEASE_DIR" ]; then
    rm -rf "$RELEASE_DIR"
  fi

  {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] Deploy failed: $PROJECT $RELEASE_ID - $reason"
  } >> "$LOG_FILE"

  exit 1
}

tar -xzf "$ARTIFACT_PATH" -C "$RELEASE_DIR"

if [ "$TYPE" = "docker" ]; then
  COMPOSE_FILE="${DOCKER_COMPOSE_FILE:-docker-compose.prod.yml}"
  DOCKER_APP_PORT="${DOCKER_PORT:-8080}"
  DOCKER_HEALTH_PATH="${DOCKER_HEALTH_PATH:-/}"

  if ! docker_validate_release "$RELEASE_DIR" "$COMPOSE_FILE"; then
    rm -rf "$RELEASE_DIR"
    {
      echo "[$(date '+%Y-%m-%d %H:%M:%S')] Deploy failed: $PROJECT $RELEASE_ID - compose file missing"
    } >> "$LOG_FILE"
    echo "Compose file not found: $RELEASE_DIR/$COMPOSE_FILE"
    exit 1
  fi

  if ! docker_deploy_release \
    "$PROJECT" \
    "$PROJECT_DIR" \
    "$RELEASE_DIR" \
    "$COMPOSE_FILE" \
    "$DOCKER_APP_PORT" \
    "$DOCKER_HEALTH_PATH" \
    "$LOG_FILE"; then
    docker_deploy_abort "Docker deployment failed"
  fi

  switch_current_release "$RELEASE_DIR"
else
  if [ "$TYPE" = "static" ] && [ ! -f "$RELEASE_DIR/$HEALTH_FILE" ]; then
    rm -rf "$RELEASE_DIR"
    echo "Health check failed: $HEALTH_FILE not found"
    {
      echo "[$(date '+%Y-%m-%d %H:%M:%S')] Deploy failed: $PROJECT $RELEASE_ID - health check file missing"
    } >> "$LOG_FILE"
    exit 1
  fi

  switch_current_release "$RELEASE_DIR"
fi

if [ -d "$RELEASES_DIR" ]; then
  ls -1dt "$RELEASES_DIR"/*/ 2>/dev/null \
    | grep -v "$RELEASE_DIR/" \
    | tail -n +$((KEEP + 1)) \
    | xargs rm -rf 2>/dev/null || true
fi

rm -f "$ARTIFACT_PATH"

{
  echo "[$(date '+%Y-%m-%d %H:%M:%S')] Deploy successful: $PROJECT $RELEASE_ID"
} >> "$LOG_FILE"

echo "Deployment successful: $PROJECT $RELEASE_ID"
