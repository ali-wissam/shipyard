#!/usr/bin/env bash
set -euo pipefail

SHIPYARD_ROOT="${SHIPYARD_ROOT:-/opt/shipyard}"

if [ ! -d "$SHIPYARD_ROOT" ]; then
  SHIPYARD_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
fi

export SHIPYARD_ROOT

COMMAND="${1:-}"

show_help() {

  echo "shipyard - small self-hosted deployment platform"

  echo ""

  echo "Usage:"

  echo "  shipyard <command> [arguments]"

  echo ""

  echo "Commands:"

  echo "  create <project>                         Create a new project structure and config"

  echo "  nginx <project>                           Generate and enable Nginx config"

  echo "  deploy <project> <artifact> <release>    Deploy an artifact to a project"

  echo "  rollback <project>                       Roll back to the previous release"

  echo "  status <project>                         Show project status"

  echo "  list                                     List configured projects"

  echo "  ssl <project>                            Issue SSL certificate with Certbot"

  echo "  dns-check <domain> <ip>                  Verify DNS resolves to expected IP"

  echo "  version                                  Show shipyard version"

  echo "  doctor                                   Check Shipyard installation health"

  echo "  help                                     Show this help message"

  echo ""

  echo "Project types: static, laravel, node, docker"

  echo ""

  echo "Examples:"

  echo "  sudo shipyard create portfolio --type static --domain example.com"

  echo "  sudo shipyard create blog --type docker --domain blog.example.com --port 8080"

  echo "  shipyard deploy portfolio /tmp/site.tar.gz abc123"

  echo "  shipyard status portfolio"

  echo "  shipyard rollback portfolio"
                                                                                                                }

case "$COMMAND" in
  create)
    shift
    "$SHIPYARD_ROOT/bin/create" "$@"
    ;;
  deploy)
    shift
    "$SHIPYARD_ROOT/bin/deploy" "$@"
    ;;
  list)
    "$SHIPYARD_ROOT/bin/list"
    ;;
  status)
    shift
    "$SHIPYARD_ROOT/bin/status" "$@"
    ;;
  rollback)
    shift
    "$SHIPYARD_ROOT/bin/rollback" "$@"
    ;;
  doctor)
    "$SHIPYARD_ROOT/bin/doctor"
    ;;
  dns-check)

    shift

    "$SHIPYARD_ROOT/bin/dns-check" "$@"
    ;;
  ssl)

    shift

    "$SHIPYARD_ROOT/bin/ssl" "$@"
    ;;
  version)

    cat "$SHIPYARD_ROOT/VERSION"
    ;;
  nginx)
    shift
    "$SHIPYARD_ROOT/bin/nginx" "$@"
    ;;
help|-h|--help|"")

    show_help
    ;;
  *)
    echo "Unknown command: $COMMAND"
    echo ""
    show_help
    exit 1
    ;;
esac
